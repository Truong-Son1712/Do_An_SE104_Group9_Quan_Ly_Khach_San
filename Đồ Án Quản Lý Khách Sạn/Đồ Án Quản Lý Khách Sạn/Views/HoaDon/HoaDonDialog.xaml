<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.HoaDon.HoaDonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lập Hóa Đơn Trả Phòng" Height="660" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2E7D32" Offset="0"/>
                        <GradientStop Color="#43A047" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="Lập Hóa Đơn &amp; Trả Phòng"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource BtnClose}" Content="✕" Foreground="#A5D6A7"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="24,16">
                <StackPanel>

                    <!-- Thông tin đặt phòng -->
                    <Border Background="#E3F2FD" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THÔNG TIN ĐẶT PHÒNG"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#1565C0" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtKhachHang" FontWeight="SemiBold" FontSize="14"
                                           Foreground="#1A237E" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtPhong"   Foreground="#546E7A" FontSize="12"/>
                                <TextBlock x:Name="TxtNgay"    Foreground="#546E7A" FontSize="12"/>
                                <TextBlock x:Name="TxtSoKhach" Foreground="#546E7A" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="TIỀN PHÒNG" FontSize="10" FontWeight="Bold"
                                           Foreground="#1565C0" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtSoNgay"   Foreground="#546E7A" FontSize="12"/>
                                <TextBlock x:Name="TxtGiaPhong" Foreground="#546E7A" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="260"/>
                                <TextBlock x:Name="TxtPhuThuInfo" Foreground="#E65100" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="260" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtTienPhong" FontSize="20" FontWeight="Bold"
                                           Foreground="#1565C0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Chi tiết thanh toán -->
                    <Border Background="#F5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT THANH TOÁN" FontSize="10" FontWeight="Bold"
                                       Foreground="#546E7A" Margin="0,0,0,12"/>

                            <!-- Tiền phòng -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="TxtTienPhongDetail" DockPanel.Dock="Right"
                                           FontSize="13" Foreground="#37474F" FontWeight="SemiBold"/>
                                <TextBlock Text="Tiền phòng:" FontSize="13" Foreground="#546E7A"/>
                            </DockPanel>

                            <!-- Chi tiết dịch vụ -->
                            <StackPanel x:Name="PnlDichVu" Visibility="Collapsed" Margin="0,0,0,4">
                                <TextBlock Text="DỊCH VỤ ĐÃ SỬ DỤNG" FontSize="10" FontWeight="Bold"
                                           Foreground="#E65100" Margin="0,0,0,6"/>
                                <!-- Các dòng dịch vụ sẽ được thêm từ code-behind -->
                                <StackPanel x:Name="PnlDichVuRows"/>
                                <DockPanel Margin="0,4,0,10">
                                    <TextBlock x:Name="TxtTienDichVu" DockPanel.Dock="Right"
                                               FontSize="13" Foreground="#F57C00" FontWeight="Bold"/>
                                    <TextBlock Text="Tổng dịch vụ:" FontSize="13"
                                               Foreground="#F57C00" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Rectangle Height="1" Fill="#FFE0B2" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Tiền giảm (chỉ hiện khi có mã giảm giá) -->
                            <DockPanel x:Name="RowTienGiam" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock x:Name="TxtTienGiamDisplay" DockPanel.Dock="Right"
                                           FontSize="13" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtTenMaGiam" FontSize="13" Foreground="#2E7D32" FontStyle="Italic"/>
                            </DockPanel>

                            <!-- VAT -->
                            <DockPanel x:Name="RowVAT" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock x:Name="TxtTienVAT" DockPanel.Dock="Right"
                                           FontSize="13" Foreground="#E65100" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtVATLabel" FontSize="13" Foreground="#E65100"/>
                            </DockPanel>

                            <!-- Tiền cọc -->
                            <DockPanel Margin="0,0,0,10" x:Name="RowTienCoc">
                                <TextBlock x:Name="TxtTienCocDisplay" DockPanel.Dock="Right"
                                           FontSize="13" Foreground="#1565C0" FontWeight="SemiBold"/>
                                <TextBlock Text="Tiền cọc (đặt phòng):" FontSize="13" Foreground="#546E7A"/>
                            </DockPanel>

                            <Rectangle Height="1.5" Fill="#DDEEFF" Margin="0,0,0,12"/>

                            <!-- Tổng cộng -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="TxtConLai" DockPanel.Dock="Right"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#37474F"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng cộng:" FontSize="13"
                                           Foreground="#546E7A" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Còn phải thanh toán (nổi bật) -->
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                                <DockPanel>
                                    <TextBlock x:Name="TxtThanhToanTraPhong" DockPanel.Dock="Right"
                                               FontSize="24" FontWeight="Bold" Foreground="#1B5E20"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Thanh toán lúc trả phòng:" FontWeight="SemiBold"
                                               FontSize="13" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Mã giảm giá -->
                    <Border Background="#F1F8E9" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MÃ GIẢM GIÁ" FontSize="10" FontWeight="Bold"
                                       Foreground="#558B2F" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtMaGiamGia" Grid.Column="0"
                                         Tag="Nhập mã giảm giá..." CharacterCasing="Upper"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Content="🔍 Kiểm Tra"
                                        Style="{StaticResource BtnOutline}"
                                        Click="BtnKiemTraMa_Click" Padding="12,6"/>
                                <Button Grid.Column="4" Content="✕ Bỏ mã"
                                        x:Name="BtnBoMa"
                                        Style="{StaticResource BtnDanger}"
                                        Click="BtnBoMa_Click" Padding="10,6"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="TxtKetQuaMa" Margin="0,8,0,0"
                                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Ghi chú -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Ghi Chú" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtGhiChu" Height="36" AcceptsReturn="False"
                                 VerticalContentAlignment="Center" Padding="10,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="PnlError" Background="#FFEBEE" CornerRadius="6"
                            Padding="12,8" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}" Width="90"
                            Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button Content="✔  Xác Nhận Trả Phòng" Style="{StaticResource BtnSuccess}"
                            Width="190" Click="BtnConfirm_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
