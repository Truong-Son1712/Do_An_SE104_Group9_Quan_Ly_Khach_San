<UserControl x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.MaGiamGia.MaGiamGiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Đồ_Án_Quản_Lý_Khách_Sạn.Helpers"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter            x:Key="BoolVis"/>
        <conv:MaGiamGiaTrangThaiColorConverter     x:Key="TTColor"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding ThemCommand}"
                        Visibility="{Binding IsQuanLy, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm Mã" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnWarning}" Command="{Binding SuaCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsQuanLy, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnDanger}" Command="{Binding XoaCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsQuanLy, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleActiveCommand}" Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnOutline}"/>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Bật/Tắt" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Mã Giảm Giá"/>
                <TextBlock Style="{StaticResource Body}" Text="Quản lý mã khuyến mãi và tỉ lệ giảm giá"/>
            </StackPanel>
        </DockPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã"           Binding="{Binding MaGG}"               Width="55"/>
                    <DataGridTextColumn Header="Tên Mã"       Binding="{Binding TenMa}"               Width="140"/>
                    <DataGridTextColumn Header="Mô Tả"        Binding="{Binding MoTa}"                Width="*"/>
                    <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding NgayBatDau, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Ngày Kết Thúc" Binding="{Binding NgayKetThuc, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="140" SortMemberPath="TrangThaiHienThi">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TrangThaiHienThi, Converter={StaticResource TTColor}}"
                                        CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="4,2">
                                    <TextBlock Text="{Binding TrangThaiHienThi}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Đã dùng / Tối đa" Binding="{Binding SoLuongHienThi}" Width="130"/>
                    <DataGridTextColumn Header="Ngày Tạo"     Binding="{Binding NgayTao, StringFormat=dd/MM/yyyy}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
