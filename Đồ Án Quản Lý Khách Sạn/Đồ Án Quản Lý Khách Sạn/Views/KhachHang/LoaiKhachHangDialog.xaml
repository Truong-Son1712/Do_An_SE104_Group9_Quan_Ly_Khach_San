<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.KhachHang.LoaiKhachHangDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loại Khách Hàng" Height="370" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#1E88E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <TextBlock x:Name="TxtTitle" Text="Thêm Loại Khách"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource BtnClose}" Content="✕"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="24,16">
                <TextBlock Text="Tên Loại Khách *" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtTenLoai" Tag="Ví dụ: Nội địa, Nước ngoài, VIP..." Margin="0,0,0,12"/>

                <TextBlock Text="Hệ Số Giá *" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtHeSoGia" Tag="Ví dụ: 1.0, 1.2, 1.5"/>
                <TextBlock Text="1.0 = giá gốc  |  1.2 = nhân thêm 20%  |  1.5 = nhân thêm 50%"
                           FontSize="10" Foreground="#90A4AE" Margin="0,3,0,0"/>

                <Border x:Name="PnlError" Background="#FFEBEE" CornerRadius="6"
                        Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}" Width="90"
                            Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="💾  Lưu" Style="{StaticResource BtnPrimary}"
                            Width="110" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
