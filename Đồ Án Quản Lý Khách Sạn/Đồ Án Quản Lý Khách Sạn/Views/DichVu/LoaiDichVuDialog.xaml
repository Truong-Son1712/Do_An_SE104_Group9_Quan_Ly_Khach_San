<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.DichVu.LoaiDichVuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loại Dịch Vụ" Height="390" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#1E88E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <TextBlock x:Name="TxtTitle" Text="Thêm Loại Dịch Vụ"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnClose}" Content="✕"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,16">
                <TextBlock Text="Tên Dịch Vụ *" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtTenLoaiDV" Tag="Ví dụ: Bữa ăn sáng, Nước suối..." Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Đơn Giá (₫) *" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtDonGia" Tag="Ví dụ: 50000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đơn Vị Tính *" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtDonViTinh" Tag="chai, bữa, chuyến, giờ..."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mô Tả" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtMoTa" Tag="Mô tả ngắn về dịch vụ" Margin="0,0,0,10"/>

                <CheckBox x:Name="ChkIsActive" Content="Còn hoạt động" IsChecked="True"/>

                <Border x:Name="PnlError" Background="#FFEBEE" CornerRadius="6"
                        Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}" Width="90"
                            Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="💾  Lưu" Style="{StaticResource BtnPrimary}"
                            Width="110" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
