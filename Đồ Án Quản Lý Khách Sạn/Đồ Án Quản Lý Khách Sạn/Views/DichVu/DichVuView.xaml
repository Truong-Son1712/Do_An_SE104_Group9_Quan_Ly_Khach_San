<UserControl x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.DichVu.DichVuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Đồ_Án_Quản_Lý_Khách_Sạn.Helpers"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="Currency"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnInfo}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm Mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding QuanLyDVCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛎" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Quản Lý Dịch Vụ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Dịch Vụ Phòng"/>
                <TextBlock Style="{StaticResource Body}" Text="Quản lý dịch vụ cho các phòng đang có khách"/>
            </StackPanel>
        </DockPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Phòng"        Binding="{Binding SoPhong}"     Width="80"/>
                    <DataGridTextColumn Header="Loại Phòng"   Binding="{Binding LoaiPhong}"   Width="*"/>
                    <DataGridTextColumn Header="Khách Hàng"   Binding="{Binding KhachHang}"   Width="*"/>
                    <DataGridTextColumn Header="Nhận Phòng"   Binding="{Binding NgayNhan,   StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Trả (Dự Kiến)" Binding="{Binding NgayTraDuKien, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Số DV"        Binding="{Binding SoDichVu}"    Width="70"/>
                    <DataGridTextColumn Header="Tổng Tiền DV" Binding="{Binding TongTienDV, Converter={StaticResource Currency}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
