<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.DichVu.QuanLyDichVuPhongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dịch Vụ Phòng" Height="580" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#1E88E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <TextBlock x:Name="TxtTitle" Foreground="White" FontSize="15"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnClose}" Content="✕"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Danh sách dịch vụ với nút + / - -->
            <ScrollViewer Grid.Row="1" Margin="16,12,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dịch Vụ" FontWeight="SemiBold"
                                   FontSize="12" Foreground="#1565C0"/>
                        <TextBlock Grid.Column="1" Text="Đơn Giá" FontWeight="SemiBold"
                                   FontSize="12" Foreground="#1565C0" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Số Lượng" FontWeight="SemiBold"
                                   FontSize="12" Foreground="#1565C0" HorizontalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#E3F2FD" Margin="0,0,0,4"/>

                    <!-- Rows sinh từ code-behind, tag: x:Name="PnlItems" -->
                    <StackPanel x:Name="PnlItems"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Tổng cộng -->
            <Border Grid.Row="2" Background="#E8F5E9" Padding="16,10" Margin="16,8">
                <DockPanel>
                    <TextBlock x:Name="TxtTong" DockPanel.Dock="Right"
                               FontSize="16" FontWeight="Bold" Foreground="#2E7D32"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Tổng tiền dịch vụ:" FontWeight="SemiBold"
                               Foreground="#388E3C" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}" Width="90"
                            Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button Content="💾  Lưu Dịch Vụ" Style="{StaticResource BtnPrimary}"
                            Width="140" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
