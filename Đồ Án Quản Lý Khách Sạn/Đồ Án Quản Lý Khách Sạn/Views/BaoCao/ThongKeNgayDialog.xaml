<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.BaoCao.ThongKeNgayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Đồ_Án_Quản_Lý_Khách_Sạn.Helpers"
        Title="Thống Kê Doanh Thu Theo Ngày" Height="640" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="Currency"/>
    </Window.Resources>

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2E7D32" Offset="0"/>
                        <GradientStop Color="#43A047" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Text="Thống Kê Doanh Thu Theo Ngày"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnClose}" Content="✕"
                            Click="BtnClose_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Filter -->
            <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1" Padding="20,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tháng:" FontWeight="SemiBold" FontSize="13"
                               Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CboThang" Width="110" SelectionChanged="CboThang_Changed"/>
                    <TextBlock x:Name="TxtNam" FontSize="13" FontWeight="SemiBold"
                               Foreground="#546E7A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Rectangle Width="1" Fill="#E0E0E0" Margin="20,0"/>
                    <TextBlock Text="Tổng tháng:" FontSize="13" Foreground="#546E7A"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTong" FontSize="14" FontWeight="Bold"
                               Foreground="#2E7D32" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Column Headers -->
            <Grid Grid.Row="2" Margin="20,10,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ngày" FontSize="11" FontWeight="Bold"
                           Foreground="#90A4AE"/>
                <TextBlock Grid.Column="2" Text="Tỷ lệ" FontSize="11" FontWeight="Bold"
                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Doanh Thu" FontSize="11" FontWeight="Bold"
                           Foreground="#90A4AE" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="HĐ" FontSize="11" FontWeight="Bold"
                           Foreground="#90A4AE" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Daily bar chart -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                <ItemsControl x:Name="IcNgay">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ngày -->
                                <TextBlock Grid.Column="0" Text="{Binding NgayText}"
                                           Foreground="#546E7A" FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- Bar -->
                                <ProgressBar Grid.Column="1" Margin="4,0"
                                             Value="{Binding TyLe, Mode=OneWay}" Maximum="100"
                                             Height="16"/>

                                <!-- % tháng -->
                                <Border Grid.Column="2" Margin="4,0" CornerRadius="10" Padding="4,2"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DoanhThu}" Value="0">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TyLeThangText}" FontSize="10"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DoanhThu}" Value="0">
                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Doanh thu -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding DoanhThuText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- Số HĐ -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding SoHoaDon, StringFormat='({0})'}"
                                           Foreground="#90A4AE" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Button Content="Đóng" Style="{StaticResource BtnOutline}"
                        Width="100" HorizontalAlignment="Right" Margin="24,0"
                        Click="BtnClose_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
