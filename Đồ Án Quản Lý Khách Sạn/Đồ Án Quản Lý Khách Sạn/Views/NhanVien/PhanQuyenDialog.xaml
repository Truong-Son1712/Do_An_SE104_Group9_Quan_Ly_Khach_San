<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.NhanVien.PhanQuyenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phân Quyền" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1B5E20" Offset="0"/>
                        <GradientStop Color="#388E3C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Text="Phân Quyền"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnClose}" Content="✕" Foreground="#A5D6A7"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Margin="24,16">
                <StackPanel>

                    <!-- Thông tin nhân viên -->
                    <Border Background="#E8F5E9" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtNhanVienInfo" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1B5E20"/>
                            <TextBlock x:Name="TxtVaiTroInfo" FontSize="11"
                                       Foreground="#4CAF50" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách quyền -->
                    <TextBlock Text="QUYỀN ĐƯỢC CẤP" FontSize="10" FontWeight="Bold"
                               Foreground="#546E7A" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="IcQuyens">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7FA" CornerRadius="6" Padding="14,10"
                                        Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right"
                                                  IsChecked="{Binding DuocCap, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TenQuyen}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#37474F"/>
                                            <TextBlock Text="{Binding MoTa}" FontSize="11"
                                                       Foreground="#90A4AE" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nút đặt lại mặc định -->
                    <Button x:Name="BtnMacDinh" Content="↺  Đặt lại quyền mặc định theo vai trò"
                            Style="{StaticResource BtnOutline}" Margin="0,8,0,0"
                            Click="BtnMacDinh_Click"/>

                    <Border x:Name="PnlError" Background="#FFEBEE" CornerRadius="6"
                            Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}"
                            Width="90" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button Content="💾  Lưu Quyền" Style="{StaticResource BtnSuccess}"
                            Width="130" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
