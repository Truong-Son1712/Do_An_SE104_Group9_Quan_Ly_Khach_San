<Window x:Class="Đồ_Án_Quản_Lý_Khách_Sạn.Views.NhanVien.LoaiNhanVienDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loại Nhân Viên" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="12" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#1E88E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,8,0">
                    <TextBlock x:Name="TxtTitle" Text="Thêm Loại Nhân Viên"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnClose}" Content="✕"
                            Click="BtnCancel_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Margin="24,16">
                <StackPanel>

                    <!-- Tên loại -->
                    <StackPanel x:Name="PnlInfo" Margin="0,0,0,12">
                        <TextBlock Text="Tên Loại Nhân Viên *" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtTenLoai"/>

                        <TextBlock Text="Mã Vai Trò *" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <TextBox x:Name="TxtVaiTroCode"
                                 ToolTip="Mã định danh nội bộ, không dấu, không khoảng trắng (vd: GiamDoc)"/>
                        <TextBlock Text="⚠ Không thể thay đổi sau khi tạo" FontSize="10"
                                   Foreground="#E65100" Margin="0,2,0,0"/>

                        <TextBlock Text="Mô Tả" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <TextBox x:Name="TxtMoTa" Height="60" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="10,8" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Quyền mặc định -->
                    <TextBlock Text="QUYỀN MẶC ĐỊNH" FontSize="10" FontWeight="Bold"
                               Foreground="#546E7A" Margin="0,0,0,8"/>
                    <TextBlock Text="Khi tạo nhân viên thuộc loại này, các quyền sau sẽ được cấp tự động."
                               FontSize="11" Foreground="#90A4AE" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="IcQuyens">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F7FA" CornerRadius="6" Padding="14,9"
                                        Margin="0,0,0,6" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right"
                                                  IsChecked="{Binding DuocCap, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TenQuyen}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#37474F"/>
                                            <TextBlock Text="{Binding MoTa}" FontSize="11"
                                                       Foreground="#90A4AE" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="PnlError" Background="#FFEBEE" CornerRadius="6"
                            Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource BtnOutline}"
                            Width="90" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="💾  Lưu" Style="{StaticResource BtnPrimary}"
                            Width="110" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
